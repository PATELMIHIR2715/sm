# ==============================================================================
# Institutional Stock News Impact Platform - Environment Template
# ==============================================================================
# Copy this file to .env and configure your production values:
# cp .env.example .env

# Gmail SMTP Delivery Gateway
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM="Institutional AI News Engine <your-email@gmail.com>"
ALERT_EMAIL_RECIPIENTS="alerts@yourdomain.com"

# Network Ports
NOTIFICATION_PORT=5001
ALERT_WHATSAPP_NUMBERS="+919876543210"
LIVE_SYNC_PORT=5000
VITE_API_URL="http://127.0.0.1:5000"
VITE_NOTIFICATIONS_URL="http://127.0.0.1:5001"

# Master Administrator Console Secret
ADMIN_SECRET_KEY="admin@institutional2026"

# TypeSafe AI Jev SystemOne Engine
JEV_API_KEY="your-typesafe-jev-api-key"
JEV_API_URL="https://api.typesafe.ai/v1/systemone"
JEV_MODEL="jev-latest"

# Supabase Cloud Warehouse (Zero-Data-Loss Historical Storage & Midnight Sync)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"

