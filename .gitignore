# ------------------------------------------------------------------------------
# 1. Confidential Credentials, Keys & Secrets (STRICT - DO NOT COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!*.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# WhatsApp Web Session Tokens & Local Auth Caches
.wwebjs_auth/
.wwebjs_cache/
tokens/
session-*/
*.session

# Sensitive Local Data Stores, Subscriber Stores & Live Poller Streams
data/jev_config.json
data/subscribers.json
data/notification_subscribers.json
data/dispatched_alerts_log.json
data/dispatch_history.json
data/live_signals_stream.json
data/signals_archive.json
data/signals_archive_90d.json
data/seen_filing_hashes.json
data/pipeline_live_progress.json
data/verified_market_live_prices.json
data/jev_classification_cache.json
data/jev_pipeline_telemetry.json

# Keep seed data & example files tracked
!data/*.example.json
!data/historical_10yr_embedded_database.json
!data/macro_patterns_master.json
!data/nifty500_master.json
!data/company_profiles/
!data/backtest_reports/

